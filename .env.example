# Copy to `.env.local` for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# --- Supabase Auth (required; identity only, the database is Neon) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Neon Postgres (required) ---
# The app's .from()/.rpc() calls go to the Neon Data API. Its URL is not a
# secret (the browser uses it). Neon verifies tokens against
# public/.well-known/jwks.json; the matching private key signs them here.
NEXT_PUBLIC_DATA_API_URL=https://YOUR_ENDPOINT.apirest.REGION.aws.neon.tech/neondb/rest/v1
# Server-only private P-256 JWK with a kid, on one line, e.g. '{"kty":"EC",...}'.
# Never prefix with NEXT_PUBLIC_. Rotate together with the public JWKS file.
DATA_API_JWT_PRIVATE_JWK=
# Direct Postgres connection (neon link/`neon env` fills these). Used for
# migrations and maintenance by hand only; the app never reads it.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# App URL: use the exact origin viewers will use (local or Vercel preview/production).
# Also add this URL to Supabase → Authentication → URL Configuration → Site URL and Redirect URLs,
# and to the Neon Data API's CORS origins (neon data-api update --server-cors-allowed-origins).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional development-only data. When true, needs/events use local fixtures
# immediately; set false to read real database data. Never enable in production.
ALLOW_LOCAL_FIXTURES=false

# --- Map basemap ---
# CARTO watermarks its basemap tiles ("API KEY REQUIRED") unless a key is sent.
# Request a free key at https://carto.com/basemaps/apikey (non-profit tier,
# 5M tiles/month) and set it here and in Vercel. It is public by nature (it
# rides in every tile URL). Without it the map falls back to OpenStreetMap's
# own tiles: light style only, dark mode via CSS filter, best-effort service.
# NEXT_PUBLIC_CARTO_API_KEY=

# --- Email (required for NGO institution-claim mailbox verification) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# --- Other ---
# Required in production; use at least 32 cryptographically random characters.
# Invoke POST /api/cron/process-notification-jobs and
# POST /api/cron/event-reminders from a scheduler that supports an
# Authorization: Bearer <CRON_SECRET> header. Vercel's GET-only cron is disabled.
# CRON_SECRET=
